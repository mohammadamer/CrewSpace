generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique
  displayName  String
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  WorkspaceMember[]
  sessions     Session[]
  sentInvitations WorkspaceInvitation[] @relation("InvitedBy")
  invitationAcceptances InvitationAcceptance[]
  auditEntries AuditLog[]
  conversationMemberships ConversationMember[] @relation("UserConversationMembers")
  authoredMessages Message[] @relation("UserAuthoredMessages")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  invitations WorkspaceInvitation[]
  auditLogs AuditLog[]
  personas AgentPersona[]
  agents Agent[]
  agentMemories AgentMemory[]
  conversations Conversation[]
  agentExecutions AgentExecution[]
  agentCommunications AgentCommunication[]

  @@index([createdAt])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  invitedById    String           @db.Uuid
  type           InvitationType
  invitedEmail   String?
  role           WorkspaceRole    @default(MEMBER)
  tokenHash      String           @unique
  passwordHash   String?
  expiresAt      DateTime
  maxUses        Int?
  usedCount      Int              @default(0)
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  acceptedAt     DateTime?
  revokedAt      DateTime?
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptances    InvitationAcceptance[]

  @@index([workspaceId, status, expiresAt])
  @@index([invitedEmail, status])
}

model InvitationAcceptance {
  id           String               @id @default(uuid()) @db.Uuid
  invitationId String               @db.Uuid
  userId       String               @db.Uuid
  acceptedAt   DateTime             @default(now())
  invitation   WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([invitationId, userId])
  @@index([userId, acceptedAt])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  actorUserId String?   @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
}

model AgentPersona {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @db.Uuid
  name                 String
  role                 String
  personality          String
  expertise            String
  responsibilities     Json
  communicationStyle   String
  behavioralRules      Json
  goals                Json
  constraints          Json
  systemPrompt         String
  isBuiltIn            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents               Agent[]

  @@unique([workspaceId, name])
  @@index([workspaceId, role])
}

model Agent {
  id                  String      @id @default(uuid()) @db.Uuid
  workspaceId         String      @db.Uuid
  personaId           String?     @db.Uuid
  name                String
  role                String
  avatar              String?
  status              AgentStatus @default(OFFLINE)
  modelConfiguration  Json
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  workspace           Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  persona             AgentPersona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  capabilities        AgentCapability[]
  activities          AgentActivity[]
  memories            AgentMemory[]
  conversationMemberships ConversationMember[] @relation("AgentConversationMembers")
  authoredMessages     Message[]
  executions           AgentExecution[]
  outgoingCommunications AgentCommunication[] @relation("SourceAgentCommunications")
  incomingCommunications AgentCommunication[] @relation("TargetAgentCommunications")

  @@index([workspaceId, status])
  @@index([personaId])
}

model AgentExecution {
  id              String                @id @default(uuid()) @db.Uuid
  agentId         String                @db.Uuid
  workspaceId     String                @db.Uuid
  status          AgentExecutionStatus  @default(QUEUED)
  prompt          String
  output          String?
  error           String?
  attempt         Int                   @default(0)
  maxAttempts     Int                   @default(3)
  timeoutMs       Int                   @default(30000)
  createdAt       DateTime              @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime              @updatedAt
  agent           Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usage           UsageRecord?

  @@index([workspaceId, createdAt])
  @@index([agentId, createdAt])
  @@index([workspaceId, status])
}

model UsageRecord {
  id             String         @id @default(uuid()) @db.Uuid
  executionId    String         @unique @db.Uuid
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  totalTokens    Int            @default(0)
  durationMs     Int            @default(0)
  createdAt      DateTime       @default(now())
  execution      AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @db.Uuid
  type        ConversationType     @default(DIRECT)
  title       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    Message[]
  agentCommunications AgentCommunication[]

  @@index([workspaceId, updatedAt])
}

model ConversationMember {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  userId         String?       @db.Uuid
  agentId        String?       @db.Uuid
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?         @relation("UserConversationMembers", fields: [userId], references: [id], onDelete: Cascade)
  agent          Agent?        @relation("AgentConversationMembers", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@unique([conversationId, agentId])
  @@index([userId])
  @@index([agentId])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  authorUserId   String?       @db.Uuid
  authorAgentId  String?       @db.Uuid
  content        String
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser     User?         @relation("UserAuthoredMessages", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAgent    Agent?        @relation(fields: [authorAgentId], references: [id], onDelete: SetNull)
  agentCommunication AgentCommunication?

  @@index([conversationId, createdAt, id])
}

model AgentCommunication {
  id             String                   @id @default(uuid()) @db.Uuid
  workspaceId    String                   @db.Uuid
  conversationId String                   @db.Uuid
  sourceAgentId  String                   @db.Uuid
  targetAgentId  String                   @db.Uuid
  messageId      String?                  @unique @db.Uuid
  depth          Int
  tokenCount     Int
  status         AgentCommunicationStatus @default(ALLOWED)
  reason         String?
  createdAt      DateTime                 @default(now())
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceAgent    Agent                    @relation("SourceAgentCommunications", fields: [sourceAgentId], references: [id], onDelete: Cascade)
  targetAgent    Agent                    @relation("TargetAgentCommunications", fields: [targetAgentId], references: [id], onDelete: Cascade)
  message        Message?                 @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
  @@index([sourceAgentId, targetAgentId, createdAt])
}

model AgentMemory {
  id          String                  @id @default(uuid()) @db.Uuid
  agentId     String                  @db.Uuid
  workspaceId String                  @db.Uuid
  type        AgentMemoryType         @default(OBSERVATION)
  title       String?
  content     String
  source      String?
  visibility  AgentKnowledgeVisibility @default(PRIVATE)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  agent       Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([workspaceId, createdAt])
}

model AgentCapability {
  id          String   @id @default(uuid()) @db.Uuid
  agentId     String   @db.Uuid
  capability  String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, capability])
  @@index([agentId, enabled])
}

model AgentActivity {
  id          String   @id @default(uuid()) @db.Uuid
  agentId     String   @db.Uuid
  type        String
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum InvitationType {
  EMAIL
  LINK
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AgentStatus {
  AVAILABLE
  THINKING
  WORKING
  WAITING
  OFFLINE
  ERROR
}

enum AgentMemoryType {
  OBSERVATION
  NOTE
  FACT
  LEARNING
  FILE_SUMMARY
}

enum AgentKnowledgeVisibility {
  PRIVATE
  SHARED
}

enum AgentExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  TIMED_OUT
  FAILED
}

enum AgentCommunicationStatus {
  ALLOWED
  BLOCKED
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}
