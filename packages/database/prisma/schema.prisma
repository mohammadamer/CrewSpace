generator client {
  provider = "prisma-client-js"
}
enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectMemberRole {
  MEMBER
  LEAD
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique
  displayName  String
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  WorkspaceMember[]
  sessions     Session[]
  sentInvitations WorkspaceInvitation[] @relation("InvitedBy")
  invitationAcceptances InvitationAcceptance[]
  auditEntries AuditLog[]
  conversationMemberships ConversationMember[] @relation("UserConversationMembers")
  authoredMessages Message[] @relation("UserAuthoredMessages")
  createdProjects Project[] @relation("ProjectCreators")
  projectMemberships ProjectMember[] @relation("UserProjectMembers")
  createdTasks Task[] @relation("TaskCreators")
  assignedTasks Task[] @relation("UserTaskAssignees")
  createdDecisions Decision[] @relation("DecisionCreators")
  createdConvenes Convene[] @relation("ConveneCreators")
  conveneParticipations ConveneParticipant[] @relation("UserConveneParticipants")
  authoredContributions ConveneContribution[] @relation("UserContributions")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  invitations WorkspaceInvitation[]
  auditLogs AuditLog[]
  personas AgentPersona[]
  agents Agent[]
  agentMemories AgentMemory[]
  conversations Conversation[]
  agentExecutions AgentExecution[]
  agentCommunications AgentCommunication[]
  agentRelationships AgentRelationship[]
  agentSchedules AgentSchedule[]
  projects Project[]
  tasks Task[]
  decisions Decision[]
  convenes Convene[]

  @@index([createdAt])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  invitedById    String           @db.Uuid
  type           InvitationType
  invitedEmail   String?
  role           WorkspaceRole    @default(MEMBER)
  tokenHash      String           @unique
  passwordHash   String?
  expiresAt      DateTime
  maxUses        Int?
  usedCount      Int              @default(0)
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  acceptedAt     DateTime?
  revokedAt      DateTime?
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptances    InvitationAcceptance[]

  @@index([workspaceId, status, expiresAt])
  @@index([invitedEmail, status])
}

model InvitationAcceptance {
  id           String               @id @default(uuid()) @db.Uuid
  invitationId String               @db.Uuid
  userId       String               @db.Uuid
  acceptedAt   DateTime             @default(now())
  invitation   WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([invitationId, userId])
  @@index([userId, acceptedAt])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  actorUserId String?   @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
}

model AgentPersona {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @db.Uuid
  name                 String
  role                 String
  personality          String
  expertise            String
  responsibilities     Json
  communicationStyle   String
  behavioralRules      Json
  goals                Json
  constraints          Json
  systemPrompt         String
  isBuiltIn            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents               Agent[]

  @@unique([workspaceId, name])
  @@index([workspaceId, role])
}

model Agent {
  id                  String      @id @default(uuid()) @db.Uuid
  workspaceId         String      @db.Uuid
  personaId           String?     @db.Uuid
  name                String
  role                String
  avatar               String?
  status              AgentStatus @default(OFFLINE)
  modelConfiguration  Json
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  workspace           Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  persona             AgentPersona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  capabilities        AgentCapability[]
  activities          AgentActivity[]
  memories            AgentMemory[]
  conversationMemberships ConversationMember[] @relation("AgentConversationMembers")
  authoredMessages     Message[]
  executions           AgentExecution[]
  outgoingCommunications AgentCommunication[] @relation("SourceAgentCommunications")
  incomingCommunications AgentCommunication[] @relation("TargetAgentCommunications")
  relationships AgentRelationship[] @relation("AgentRelationships")
  relatedRelationships AgentRelationship[] @relation("RelatedAgentRelationships")
  schedules AgentSchedule[]
  projectMemberships ProjectMember[] @relation("AgentProjectMembers")
  assignedTasks Task[] @relation("AgentTaskAssignees")
  conveneParticipations ConveneParticipant[] @relation("AgentConveneParticipants")
  authoredContributions ConveneContribution[] @relation("AgentContributions")

  @@index([workspaceId, status])
  @@index([personaId])
}

model AgentExecution {
  id              String                @id @default(uuid()) @db.Uuid
  agentId         String                @db.Uuid
  workspaceId     String                @db.Uuid
  status          AgentExecutionStatus  @default(QUEUED)
  prompt          String
  output          String?
  error           String?
  attempt         Int                   @default(0)
  maxAttempts     Int                   @default(3)
  timeoutMs       Int                   @default(30000)
  createdAt       DateTime              @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime              @updatedAt
  agent           Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usage           UsageRecord?

  @@index([workspaceId, createdAt])
  @@index([agentId, createdAt])
  @@index([workspaceId, status])
}

model UsageRecord {
  id             String         @id @default(uuid()) @db.Uuid
  executionId    String         @unique @db.Uuid
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  totalTokens    Int            @default(0)
  durationMs     Int            @default(0)
  createdAt      DateTime       @default(now())
  execution      AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @db.Uuid
  type        ConversationType     @default(DIRECT)
  title       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    Message[]
  agentCommunications AgentCommunication[]
  sourceDecisions Decision[]

  @@index([workspaceId, updatedAt])
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  createdById String        @db.Uuid
  name        String
  description String?
  status      ProjectStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User          @relation("ProjectCreators", fields: [createdById], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  tasks       Task[]
  decisions   Decision[]
  convenes    Convene[]

  @@index([workspaceId, status])
  @@index([createdById])
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String?  @db.Uuid
  agentId   String?  @db.Uuid
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation("UserProjectMembers", fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation("AgentProjectMembers", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@unique([projectId, agentId])
  @@index([userId])
  @@index([agentId])
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @db.Uuid
  projectId      String       @db.Uuid
  createdById    String       @db.Uuid
  assigneeUserId String?      @db.Uuid
  assigneeAgentId String?     @db.Uuid
  decisionId     String?      @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("TaskCreators", fields: [createdById], references: [id], onDelete: Restrict)
  assigneeUser   User?        @relation("UserTaskAssignees", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeAgent  Agent?       @relation("AgentTaskAssignees", fields: [assigneeAgentId], references: [id], onDelete: SetNull)
  decision       Decision?    @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  dependencies   TaskDependency[] @relation("TaskDependencies")
  dependents     TaskDependency[] @relation("TaskDependents")

  @@index([workspaceId, status, priority])
  @@index([projectId, status])
  @@index([assigneeUserId])
  @@index([assigneeAgentId])
}

model TaskDependency {
  taskId        String @db.Uuid
  dependsOnTaskId String @db.Uuid
  createdAt     DateTime @default(now())
  task          Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model Decision {
  id                 String       @id @default(uuid()) @db.Uuid
  workspaceId        String       @db.Uuid
  projectId          String?      @db.Uuid
  createdById        String       @db.Uuid
  sourceConversationId String?    @db.Uuid
  title              String
  context            String
  alternatives       Json
  conclusion         String
  provenance         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy          User         @relation("DecisionCreators", fields: [createdById], references: [id], onDelete: Restrict)
  sourceConversation Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  conveneId           String?      @unique @db.Uuid
  convene             Convene?     @relation(fields: [conveneId], references: [id], onDelete: SetNull)
  tasks              Task[]

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
}

model Convene {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  projectId   String?       @db.Uuid
  createdById String        @db.Uuid
  title       String
  topic       String
  status      ConveneStatus @default(DRAFT)
  startedAt   DateTime?
  pausedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("ConveneCreators", fields: [createdById], references: [id], onDelete: Restrict)
  participants ConveneParticipant[]
  contributions ConveneContribution[]
  decision    Decision?

  @@index([workspaceId, status, updatedAt])
  @@index([projectId, createdAt])
}

model ConveneParticipant {
  id        String              @id @default(uuid()) @db.Uuid
  conveneId String              @db.Uuid
  userId    String?             @db.Uuid
  agentId   String?             @db.Uuid
  role      ConveneParticipantRole @default(PARTICIPANT)
  createdAt DateTime            @default(now())
  convene   Convene             @relation(fields: [conveneId], references: [id], onDelete: Cascade)
  user      User?               @relation("UserConveneParticipants", fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent?              @relation("AgentConveneParticipants", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([conveneId, userId])
  @@unique([conveneId, agentId])
  @@index([userId])
  @@index([agentId])
}

model ConveneContribution {
  id          String                  @id @default(uuid()) @db.Uuid
  conveneId   String                  @db.Uuid
  authorUserId String?                @db.Uuid
  authorAgentId String?               @db.Uuid
  type        ConveneContributionType  @default(DISCUSSION)
  content     String
  createdAt   DateTime                @default(now())
  convene     Convene                 @relation(fields: [conveneId], references: [id], onDelete: Cascade)
  authorUser  User?                   @relation("UserContributions", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAgent Agent?                  @relation("AgentContributions", fields: [authorAgentId], references: [id], onDelete: SetNull)

  @@index([conveneId, createdAt])
}

model ConversationMember {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  userId         String?       @db.Uuid
  agentId        String?       @db.Uuid
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?         @relation("UserConversationMembers", fields: [userId], references: [id], onDelete: Cascade)
  agent          Agent?        @relation("AgentConversationMembers", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@unique([conversationId, agentId])
  @@index([userId])
  @@index([agentId])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  authorUserId   String?       @db.Uuid
  authorAgentId  String?       @db.Uuid
  content        String
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser     User?         @relation("UserAuthoredMessages", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAgent    Agent?        @relation(fields: [authorAgentId], references: [id], onDelete: SetNull)
  agentCommunication AgentCommunication?

  @@index([conversationId, createdAt, id])
}

model AgentCommunication {
  id             String                   @id @default(uuid()) @db.Uuid
  workspaceId    String                   @db.Uuid
  conversationId String                   @db.Uuid
  sourceAgentId  String                   @db.Uuid
  targetAgentId  String                   @db.Uuid
  messageId      String?                  @unique @db.Uuid
  depth          Int
  tokenCount     Int
  status         AgentCommunicationStatus @default(ALLOWED)
  reason         String?
  createdAt      DateTime                 @default(now())
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceAgent    Agent                    @relation("SourceAgentCommunications", fields: [sourceAgentId], references: [id], onDelete: Cascade)
  targetAgent    Agent                    @relation("TargetAgentCommunications", fields: [targetAgentId], references: [id], onDelete: Cascade)
  message        Message?                 @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
  @@index([sourceAgentId, targetAgentId, createdAt])
}

model AgentRelationship {
  id                      String   @id @default(uuid()) @db.Uuid
  workspaceId             String   @db.Uuid
  agentId                 String   @db.Uuid
  relatedAgentId          String   @db.Uuid
  summary                 String?
  interactionCount        Int      @default(0)
  communicationPreferences Json
  recentInteractions      Json
  unresolvedTopics        Json
  lastInteractionAt       DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent                   Agent    @relation("AgentRelationships", fields: [agentId], references: [id], onDelete: Cascade)
  relatedAgent            Agent    @relation("RelatedAgentRelationships", fields: [relatedAgentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, agentId, relatedAgentId])
  @@index([workspaceId, updatedAt])
  @@index([agentId, relatedAgentId])
}

model AgentSchedule {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  agentId           String   @db.Uuid
  enabled           Boolean  @default(true)
  cadenceMinutes    Int
  timezone          String
  activeHoursStart  String
  activeHoursEnd    String
  cooldownMinutes   Int      @default(0)
  dailyBudget       Int      @default(1)
  budgetUsed        Int      @default(0)
  budgetResetAt     DateTime?
  lastWakeAt        DateTime?
  nextWakeAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  wakeCycles        AgentWakeCycle[]

  @@unique([workspaceId, agentId])
  @@index([workspaceId, enabled, nextWakeAt])
}

model AgentWakeCycle {
  id          String          @id @default(uuid()) @db.Uuid
  scheduleId  String          @db.Uuid
  status      AgentWakeStatus
  reason      String
  createdAt   DateTime        @default(now())
  schedule    AgentSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, createdAt])
}

model AgentMemory {
  id          String                  @id @default(uuid()) @db.Uuid
  agentId     String                  @db.Uuid
  workspaceId String                  @db.Uuid
  type        AgentMemoryType         @default(OBSERVATION)
  title       String?
  content     String
  source      String?
  visibility  AgentKnowledgeVisibility @default(PRIVATE)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  agent       Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([workspaceId, createdAt])
}

model AgentCapability {
  id          String   @id @default(uuid()) @db.Uuid
  agentId     String   @db.Uuid
  capability  String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, capability])
  @@index([agentId, enabled])
}

model AgentActivity {
  id          String   @id @default(uuid()) @db.Uuid
  agentId     String   @db.Uuid
  type        String
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum InvitationType {
  EMAIL
  LINK
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AgentStatus {
  AVAILABLE
  THINKING
  WORKING
  WAITING
  OFFLINE
  ERROR
}

enum AgentMemoryType {
  OBSERVATION
  NOTE
  FACT
  LEARNING
  FILE_SUMMARY
}

enum AgentKnowledgeVisibility {
  PRIVATE
  SHARED
}

enum AgentExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  TIMED_OUT
  FAILED
}

enum AgentCommunicationStatus {
  ALLOWED
  BLOCKED
}

enum AgentWakeStatus {
  EXECUTED
  NO_ACTION
  BLOCKED
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

enum ConveneStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum ConveneParticipantRole {
  FACILITATOR
  PARTICIPANT
  OBSERVER
}

enum ConveneContributionType {
  DISCUSSION
  EVIDENCE
  SYNTHESIS
}
